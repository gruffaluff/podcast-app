DEFINE SCHEMA

    // Generated by hand from App/Models.swift and App/RealtimeAlerts.swift.
    // Loaded into Development by the Codemagic "cloudkit-schema" workflow;
    // then Deploy Schema Changes to Production in the CloudKit Console.

    RECORD TYPE CD_Podcast (
        "___createTime"  TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        CD_entityName           STRING,
        CD_feedURL              STRING,
        CD_title                STRING,
        CD_author               STRING,
        CD_summary              STRING,
        CD_artworkURL           STRING,
        CD_autoAddRaw           STRING,
        CD_topRank              INT64,
        CD_autoDownload         INT64,
        CD_notify               INT64,
        CD_speakerNamesData     BYTES,
        CD_speakerNamesData_ckAsset ASSET,
        CD_genre                STRING,
        CD_website              STRING,
        CD_followedAt           TIMESTAMP,
        CD_lastChecked          TIMESTAMP,
        CD_speedOverride        DOUBLE,
        CD_skipIntro            DOUBLE,
        CD_skipOutro            DOUBLE,
        CD_downloadLimit        INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PodcastEpisode (
        "___createTime"  TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        CD_entityName           STRING,
        CD_episodeID            STRING,
        CD_guid                 STRING,
        CD_title                STRING,
        CD_summary              STRING,
        CD_published            TIMESTAMP,
        CD_audioURL             STRING,
        CD_duration             DOUBLE,
        CD_artworkURL           STRING,
        CD_webLink              STRING,
        CD_transcriptURL        STRING,
        CD_transcriptType       STRING,
        CD_transcriptStateRaw   STRING,
        CD_transcriptFile       STRING,
        CD_adBreaksData         BYTES,
        CD_adBreaksData_ckAsset ASSET,
        CD_dismissedAdsData     BYTES,
        CD_dismissedAdsData_ckAsset ASSET,
        CD_adsChecked           INT64,
        CD_adScannedData        BYTES,
        CD_adScannedData_ckAsset ASSET,
        CD_autoChaptersData     BYTES,
        CD_autoChaptersData_ckAsset ASSET,
        CD_syncAnchorsData      BYTES,
        CD_syncAnchorsData_ckAsset ASSET,
        CD_chaptersURL          STRING,
        CD_position             DOUBLE,
        CD_played               INT64,
        CD_playedAt             TIMESTAMP,
        CD_lastPlayedAt         TIMESTAMP,
        CD_downloadFile         STRING,
        CD_podcast              STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Bookmark (
        "___createTime"  TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        CD_entityName           STRING,
        CD_episodeID            STRING,
        CD_time                 DOUBLE,
        CD_text                 STRING,
        CD_created              TIMESTAMP,
        CD_length               DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ListeningLog (
        "___createTime"  TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        CD_entityName           STRING,
        CD_day                  TIMESTAMP,
        CD_feedURL              STRING,
        CD_showTitle            STRING,
        CD_seconds              DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_UpNextEntry (
        "___createTime"  TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        CD_entityName           STRING,
        CD_episodeID            STRING,
        CD_manual               INT64,
        CD_order                INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE PoddeckFollows (
        "___createTime"  TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        feeds                   LIST<STRING>,
        alertFeeds              LIST<STRING>,
        updated                 TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE PoddeckAlertEpisode (
        "___createTime"  TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        feedURL                 STRING,
        showTitle               STRING,
        episodeTitle            STRING,
        guid                    STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE PoddeckQuietEpisode (
        "___createTime"  TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        feedURL                 STRING,
        showTitle               STRING,
        episodeTitle            STRING,
        guid                    STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE PoddeckAlertState (
        "___createTime"  TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        json                    STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        roles            LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
