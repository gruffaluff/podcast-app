<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keep playing when the screen is locked or another app is open. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
		<string>fetch</string>
		<!-- Hear about changes from iCloud sync. -->
		<string>remote-notification</string>
	</array>
	<!-- Overnight transcription while charging. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.gruffaluff.podcasts.transcribe</string>
		<string>com.gruffaluff.podcasts.refresh</string>
	</array>
	<!-- CarPlay (CarPlaySceneDelegate). It only shows up in cars once Apple
	     grants the CarPlay audio entitlement (see docs/SETUP.md). -->
	<!-- Touch and hold the app icon (App/QuickActions.swift). -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.gruffaluff.podcasts.playUpNext</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Play Up Next</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>play.fill</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.gruffaluff.podcasts.upNext</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Up Next</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>list.bullet</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.gruffaluff.podcasts.search</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Search</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>magnifyingglass</string>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- OPML show lists, for Import & export on the Shows screen. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.opml.opml</string>
			<key>UTTypeDescription</key>
			<string>OPML show list</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>opml</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>text/x-opml</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Transcripts are made on your iPhone from episodes you've downloaded. Nothing is sent anywhere.</string>
	<!-- Many podcast feeds and audio files are still served over plain http. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
